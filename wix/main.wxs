<?xml version='1.0' encoding='utf-8'?>
<!--
  EdgeCut MSI インストーラー定義 (cargo-wix / WiX Toolset v3)

  インストール先: %LOCALAPPDATA%\edge-cut
  ブランド画像: wix/Banner.bmp (493x58), wix/Dialog.bmp (493x312, 左装飾+右白)
                scripts/windows/generate-wix-assets.ps1 で再生成可能
  画面:         WixUI_FeatureTree からライセンス同意画面を除いた独自 UI (MIT License は同意を要しない)
  同梱文書:     THIRD_PARTY_NOTICES (scripts/common/generate-third-party-notices.* で生成)
                docs\ 利用者向けドキュメント (mdBook の HTML。ComponentGroup UserDocs は
                scripts/common/build-user-docs.ps1 が target/wix/user-docs.wxs に生成する)
-->

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='EdgeCut'
        UpgradeCode='72F3B69C-49F4-41F8-BB3B-C69033838D51'
        Manufacturer='Yuto Hirata'
        Language='1041'
        Codepage='932'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='画像の背景余白を自動検出・トリミングする GUI ツール'
            Manufacturer='Yuto Hirata'
            InstallerVersion='450'
            Languages='1041'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='932'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            DowngradeErrorMessage='[ProductName] の新しいバージョンが既にインストールされています。セットアップを終了します。'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='EdgeCut インストール'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='APPLICATIONFOLDER' Name='edge-cut'>

                    <Component Id='License' Guid='F3A8C1E2-5B4D-4E6A-9C1F-2D5E6A9B0C4D'>
                        <File Id='LicenseFile' Name='LICENSE' DiskId='1' Source='LICENSE'/>
                        <RegistryValue Root='HKCU' Key='Software\Yuto Hirata\edge-cut' Name='license' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>

                    <Component Id='ThirdPartyNotices' Guid='B2C4E6F8-1A3D-4B5E-9C7D-0E2F4A6B8C0D'>
                        <File Id='ThirdPartyNoticesFile' Name='THIRD_PARTY_NOTICES' DiskId='1' Source='THIRD_PARTY_NOTICES'/>
                        <RegistryValue Root='HKCU' Key='Software\Yuto Hirata\edge-cut' Name='third_party_notices' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>

                    <Directory Id='DocsDir' Name='docs'/>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='35AA52E3-6EAB-4607-B897-96752961A613'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='no'/>
                            <RegistryValue Root='HKCU' Key='Software\Yuto Hirata\edge-cut' Name='path' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='E029C37A-4937-4194-B3AD-D24DC55E554F'>
                            <File
                                Id='exe0'
                                Name='EdgeCut.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\EdgeCut.exe'/>
                            <RemoveFolder Id='RemoveBinFolder' Directory='Bin' On='uninstall'/>
                            <RemoveFolder Id='RemoveApplicationFolder' Directory='APPLICATIONFOLDER' On='uninstall'/>
                            <RegistryValue Root='HKCU' Key='Software\Yuto Hirata\edge-cut' Name='main' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>
                        <!-- 更新プログラム。本体が %TEMP% へコピーして起動し、無人インストールと再起動を行う -->
                        <Component Id='binary1' Guid='EADD4DF7-A7BD-4CBF-B2E6-90D38FAE0C14'>
                            <File
                                Id='exe1'
                                Name='EdgeCutUpdater.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\EdgeCutUpdater.exe'/>
                            <RegistryValue Root='HKCU' Key='Software\Yuto Hirata\edge-cut' Name='updater' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='EdgeCut'/>
            </Directory>
        </Directory>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='StartMenuShortcut' Guid='64B9A30D-3D20-4CD6-B7E1-CC24A8FDB9BB'>
                <Shortcut
                    Id='EdgeCutStartMenuShortcut'
                    Name='EdgeCut'
                    Description='画像の背景余白を自動検出・トリミングする GUI ツール'
                    Target='[Bin]EdgeCut.exe'
                    WorkingDirectory='Bin'
                    Icon='ProductICO'/>
                <RemoveFolder Id='RemoveApplicationProgramsFolder' Directory='ApplicationProgramsFolder' On='uninstall'/>
                <RegistryValue Root='HKCU' Key='Software\Yuto Hirata\edge-cut' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
            <Component Id='DocsShortcut' Guid='584C4A10-3CDD-4328-B241-7E771DCCF43C'>
                <Shortcut
                    Id='EdgeCutDocsShortcut'
                    Name='EdgeCut ドキュメント'
                    Description='EdgeCut の使い方・対応フォーマット・トラブルシューティング'
                    Target='[DocsDir]index.html'
                    WorkingDirectory='DocsDir'/>
                <RegistryValue Root='HKCU' Key='Software\Yuto Hirata\edge-cut' Name='docs_shortcut' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <Feature
            Id='Binaries'
            Title='アプリケーション'
            Description='実行ファイルをインストールする'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='License'/>
            <ComponentRef Id='ThirdPartyNotices'/>
            <ComponentRef Id='StartMenuShortcut'/>
            <ComponentRef Id='DocsShortcut'/>
            <ComponentGroupRef Id='UserDocs'/>

            <Feature
                Id='Environment'
                Title='PATH 環境変数'
                Description='[ProductName] のインストール先をユーザー PATH 環境変数に追加する。任意の場所から [ProductName] を実行できるようになる'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='assets/icons/icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />

        <!-- 完了画面の「起動する」チェックボックス (既定でオン)。手動で更新したあとアプリが終了したままにならないようにする -->
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='EdgeCut を起動する'/>
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1'/>
        <CustomAction
            Id='LaunchApplication'
            FileKey='exe0'
            ExeCommand=''
            Execute='immediate'
            Impersonate='yes'
            Return='asyncNoWait'/>

        <!--
          WixUI_FeatureTree (WiX v3.14 SDK/wixui/WixUI_FeatureTree.wxs) から LicenseAgreementDlg を除いたもの。
          初回インストールは WelcomeDlg → CustomizeDlg → VerifyReadyDlg の順に進む。
          更新プログラムの無人インストール (msiexec /qn) では画面を出さないため、起動は更新プログラムが行う
        -->
        <UI Id='EdgeCutUI_FeatureTree'>
            <TextStyle Id='WixUI_Font_Normal' FaceName='Tahoma' Size='8'/>
            <TextStyle Id='WixUI_Font_Bigger' FaceName='Tahoma' Size='12'/>
            <TextStyle Id='WixUI_Font_Title' FaceName='Tahoma' Size='9' Bold='yes'/>

            <Property Id='DefaultUIFont' Value='WixUI_Font_Normal'/>
            <Property Id='WixUI_Mode' Value='FeatureTree'/>

            <DialogRef Id='ErrorDlg'/>
            <DialogRef Id='FatalError'/>
            <DialogRef Id='FilesInUse'/>
            <DialogRef Id='MsiRMFilesInUse'/>
            <DialogRef Id='PrepareDlg'/>
            <DialogRef Id='ProgressDlg'/>
            <DialogRef Id='ResumeDlg'/>
            <DialogRef Id='UserExit'/>

            <Publish Dialog='ExitDialog' Control='Finish' Event='EndDialog' Value='Return' Order='999'>1</Publish>
            <Publish Dialog='ExitDialog' Control='Finish' Event='DoAction' Value='LaunchApplication' Order='999'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>

            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg'>NOT Installed</Publish>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='VerifyReadyDlg'>Installed AND PATCH</Publish>

            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='MaintenanceTypeDlg' Order='1'>Installed</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='2'>NOT Installed</Publish>
            <Publish Dialog='CustomizeDlg' Control='Next' Event='NewDialog' Value='VerifyReadyDlg'>1</Publish>

            <Publish Dialog='VerifyReadyDlg' Control='Back' Event='NewDialog' Value='CustomizeDlg' Order='1'>NOT Installed OR WixUI_InstallMode = "Change"</Publish>
            <Publish Dialog='VerifyReadyDlg' Control='Back' Event='NewDialog' Value='MaintenanceTypeDlg' Order='2'>Installed AND NOT PATCH</Publish>
            <Publish Dialog='VerifyReadyDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='3'>Installed AND PATCH</Publish>

            <Publish Dialog='MaintenanceWelcomeDlg' Control='Next' Event='NewDialog' Value='MaintenanceTypeDlg'>1</Publish>

            <Publish Dialog='MaintenanceTypeDlg' Control='ChangeButton' Event='NewDialog' Value='CustomizeDlg'>1</Publish>
            <Publish Dialog='MaintenanceTypeDlg' Control='RepairButton' Event='NewDialog' Value='VerifyReadyDlg'>1</Publish>
            <Publish Dialog='MaintenanceTypeDlg' Control='RemoveButton' Event='NewDialog' Value='VerifyReadyDlg'>1</Publish>
            <Publish Dialog='MaintenanceTypeDlg' Control='Back' Event='NewDialog' Value='MaintenanceWelcomeDlg'>1</Publish>
        </UI>
        <UIRef Id='WixUI_Common'/>

        <WixVariable Id='WixUIBannerBmp' Value='wix\Banner.bmp'/>
        <WixVariable Id='WixUIDialogBmp' Value='wix\Dialog.bmp'/>

    </Product>

</Wix>
